{
  "name": "dbopt-core",
  "version": "0.4.0",
  "description": "Find and fix slow SQL before it reaches production. A local-first database performance analyzer compiled from Rust to WebAssembly \u2014 runs in Node and the browser and sends nothing anywhere. SQL Server rules today; engine-agnostic by design.",
  "license": "Apache-2.0",
  "homepage": "https://dbopt.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singhpratech/dbopt.git"
  },
  "bugs": {
    "url": "https://github.com/singhpratech/dbopt/issues"
  },
  "keywords": [
    "sql",
    "database",
    "query-optimizer",
    "performance",
    "linter",
    "static-analysis",
    "index",
    "query-plan",
    "wasm",
    "sqlserver",
    "tsql",
    "mssql"
  ],
  "types": "./node.d.ts",
  "main": "./node/index.cjs",
  "exports": {
    ".": {
      "types": "./node.d.ts",
      "node": "./node/index.cjs",
      "browser": {
        "types": "./web.d.ts",
        "default": "./web/index.mjs"
      },
      "default": {
        "types": "./web.d.ts",
        "default": "./web/index.mjs"
      }
    },
    "./web": {
      "types": "./web.d.ts",
      "default": "./web/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "node/",
    "web/",
    "types.d.ts",
    "node.d.ts",
    "web.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
